{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Dashly Backend (Express)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "./backend",
      "port": 3001,
      "env": {
        "NODE_ENV": "development",
        "SECRET_KEY": "${env:SECRET_KEY}"
      }
    },
    {
      "name": "Dashly Frontend (Vite + React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "./frontend",
      "port": 5173,
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}